# URL de base de l'API backend Makinum (NestJS).
NEXT_PUBLIC_API_URL=http://localhost:4000

# Adresse publique du site (sans slash final) : sert de base aux URLs
# canoniques, au sitemap.xml, au robots.txt et aux balises Open Graph/Twitter
# (aperçus WhatsApp/Facebook). Comme NEXT_PUBLIC_API_URL, elle est inlinée au
# build — voir la garde correspondante dans le Dockerfile.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# OPTIONNELLE (T61a) : liste d'anciens hôtes séparés par des virgules,
# insensible à la casse (ex. makinum.kingreys.fr) — toute requête dont
# l'en-tête Host figure dans cette liste est redirigée en 308 vers
# NEXT_PUBLIC_SITE_URL, chemin et query préservés. Runtime (pas besoin d'un
# rebuild), variable de migration de domaine : absente/vide = aucun effet
# (voir src/proxy.ts et src/lib/legacy-redirect.ts). Ne PAS la définir en dev.
# LEGACY_REDIRECT_HOSTS=makinum.kingreys.fr
